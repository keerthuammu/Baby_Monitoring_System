# ==========================================
# Smart Baby Monitoring System - Environment Configuration
# ==========================================

# Backend Configuration
ENVIRONMENT=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change_this_to_a_secure_random_string_in_production
API_KEY=baby_monitor_device_secret_key_123

# Database Configuration
# For local PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/baby_monitor_db
# SQLite Fallback (useful for quick local dev/testing without active PostgreSQL service):
# DATABASE_URL=sqlite:///./baby_monitor.db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Device & Alert Thresholds
SOUND_HIGH_THRESHOLD=65.0
CRYING_CONFIDENCE_THRESHOLD=0.70
AUDIO_RETENTION_DAYS=7
